# URL of the local/self-hosted Residual Factory control API.
# Studio proxies it server-side; the browser never receives this value.
RESIDUAL_FACTORY_API=http://127.0.0.1:8765

# Optional. Without this value Studio control actions fail closed/read-only.
# Configure the same token on the Python Studio API process.
RESIDUAL_STUDIO_CONTROL_TOKEN=replace-with-local-operator-token
