  },
  "public_python_sdk_surface": {
    "client": "openshell.SandboxClient",
    "required_methods": [
      "health",
      "create",
      "wait_ready",
      "get",
      "exec",
      "delete",
      "wait_deleted"
    ],
    "version_observation": "health().version",
    "workspace_explicit": true,
    "command_form": "argv",
    "supports_no_login_shell": true
  },
  "release_binding_contract": {
    "residual_class": "PythonSDKReleaseBinding",
    "must_supply": [
      "spec_factory",
      "state_resolver",
      "artifact_collector",
      "observation_collector",
      "candidate_parser"
    ],
    "residual_core_imports_openshell_private_proto": false,
    "auth_constructed_inside_residual_binding": false,
    "gateway_and_sdk_version_must_match": true,
    "source_identity_must_be_exact": true
  },
  "policy_semantics_to_verify": {
    "schema_version": 1,
    "startup_or_static_fields": [
      "filesystem_policy",
      "landlock",
      "process"
    ],
    "live_or_dynamic_fields": [
      "network_policies",
      "network_middlewares"
    ],
    "effective_policy_must_be_observed_not_assumed": true,
    "provider_rules_may_change_effective_policy": true,
    "broad_permissions_default": "reject_in_residual_ir"
  },
  "sandbox_identity_requirements": {
    "request_digest_label": true,
    "attempt_id_label": true,
    "create_id_equals_inspect_id": true,
    "delete_id_equals_created_id": true,
    "request_reuse_across_attempts": false
  },
  "artifact_requirements": {
    "exact_expected_output_set": true,
    "sha256_each_artifact": true,
    "byte_length_each_artifact": true,
    "one_byte_mutation_negative_test": true,
    "byte_exact_admission_separate_from_sandbox_success": true
  },
  "first_qualification_target": {
    "profile": "openshell/direct",
    "compute_driver": "docker",
    "release": "v0.1.1",
    "live_gateway_required": true,
    "provider_credentials_required_for_initial_no_network_fixture": false,
    "accepted_main_write_authority": false
  },
  "not_claimed": [
