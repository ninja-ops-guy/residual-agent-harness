{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residual.local/schemas/mc-v1-native-evidence-v2.json",
  "title": "RESIDUAL MC-V1-001 installed-native qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "station",
    "harnesses",
    "two_conversation_demo",
    "independent_review",
    "evidence_files",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "residual.mc-v1-native-evidence.v2"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "attempt",
        "spec_hash",
        "false_completion_before_state",
        "false_completion_after_state",
        "verified_transition_observed",
        "acceptance_authority",
        "evidence_file"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "spec_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "false_completion_before_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "false_completion_after_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "verified_transition_observed": {
          "const": true
        },
        "acceptance_authority": {
          "const": "station_only"
        },
        "evidence_file": {
          "$ref": "#/$defs/file_name"
        }
      }
    },
    "harnesses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "runtime_version",
          "build_identity",
          "plugin_source_sha256",
          "conversation_id",
          "instance_id",
          "binding_id",
          "context_delivery_proven",
          "inbound_observation_proven",
          "reconnect_proven",
          "restart_proven",
          "wrong_id_rejected",
          "revoked_binding_rejected",
          "stale_attempt_rejected",
          "text_private_by_default",
          "no_acceptance_authority",
          "gateway_restart_proven",
          "cancellation_stop_proven",
          "hook_executions"
        ],
        "properties": {
          "name": {
            "enum": [
              "hermes",
              "openclaw"
            ]
          },
          "runtime_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "build_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "plugin_source_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "context_delivery_proven": {
            "const": true
          },
          "inbound_observation_proven": {
            "const": true
          },
          "reconnect_proven": {
            "const": true
          },
          "restart_proven": {
            "const": true
          },
          "wrong_id_rejected": {
            "const": true
          },
          "revoked_binding_rejected": {
            "const": true
          },
          "stale_attempt_rejected": {
            "const": true
          },
          "text_private_by_default": {
            "const": true
          },
          "no_acceptance_authority": {
            "const": true
          },
          "gateway_restart_proven": {
            "type": "boolean"
          },
          "cancellation_stop_proven": {
            "type": "boolean"
          },
          "hook_executions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hook",
                "evidence_file"
              ],
              "properties": {
                "hook": {
                  "$ref": "#/$defs/hook_name"
                },
                "evidence_file": {
                  "$ref": "#/$defs/file_name"
                }
              }
            }
          }
        }
      }
    },
    "two_conversation_demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_station_task",
        "both_conversations_received_current_context",
        "bidirectional_observation_proven",
        "false_completion_did_not_accept",
        "station_verifier_completed_transition"
      ],
      "properties": {
        "same_station_task": {
          "const": true
        },
        "both_conversations_received_current_context": {
          "const": true
        },
        "bidirectional_observation_proven": {
          "const": true
        },
        "false_completion_did_not_accept": {
          "const": true
        },
        "station_verifier_completed_transition": {
          "const": true
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "verdict",
        "reviewer_not_executor"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "const": "PASS"
        },
        "reviewer_not_executor": {
          "const": true
        }
      }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/file_name"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "maxItems": 128
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
      },
      "maxItems": 32
    }
  },
  "description": "Version 2: offline consistency and byte-integrity contract; execution authenticity and secret review remain external. The validator enforces this schema's closed keyword subset.",
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "wheel_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "wheel_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "attempt",
        "spec_hash"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "spec_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "file_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "hook_name": {
      "enum": [
        "pre_llm_call",
        "post_llm_call",
        "message_received",
        "message_sent",
        "before_prompt_build",
        "gateway_stop"
      ]
    },
    "station_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate",
        "station",
        "false_completion_before_state",
        "false_completion_after_state",
        "verified_transition_observed",
        "acceptance_authority",
        "raw_evidence_files"
      ],
      "properties": {
        "schema": {
          "const": "residual.mc-v1-native-station.v1"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "station": {
          "$ref": "#/$defs/facts"
        },
        "false_completion_before_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "false_completion_after_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "verified_transition_observed": {
          "const": true
        },
        "acceptance_authority": {
          "const": "station_only"
        },
        "raw_evidence_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/file_name"
          }
        }
      }
    },
    "hook_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate",
        "station",
        "harness",
        "runtime_version",
        "build_identity",
        "plugin_source_sha256",
        "conversation_id",
        "instance_id",
        "binding_id",
        "hook",
        "event_id",
        "observed_at",
        "executed",
        "raw_evidence_files"
      ],
      "properties": {
        "schema": {
          "const": "residual.mc-v1-native-hook.v1"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "station": {
          "$ref": "#/$defs/facts"
        },
        "harness": {
          "enum": [
            "hermes",
            "openclaw"
          ]
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "build_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "plugin_source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "hook": {
          "$ref": "#/$defs/hook_name"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "executed": {
          "const": true
        },
        "raw_evidence_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/file_name"
          }
        }
      }
    }
  }
}
