{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residual.local/schemas/mc-v1-native-evidence-v1.json",
  "title": "RESIDUAL MC-V1-001 installed-native qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "station",
    "harnesses",
    "two_conversation_demo",
    "independent_review",
    "evidence_files",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "residual.mc-v1-native-evidence.v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "wheel_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "wheel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "attempt",
        "spec_hash",
        "false_completion_before_state",
        "false_completion_after_state",
        "verified_transition_observed",
        "acceptance_authority"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "false_completion_before_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "false_completion_after_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified_transition_observed": {
          "const": true
        },
        "acceptance_authority": {
          "const": "station_only"
        }
      }
    },
    "harnesses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "runtime_version",
          "build_identity",
          "plugin_source_sha256",
          "conversation_id",
          "instance_id",
          "binding_id",
          "hook_registration_proven",
          "context_delivery_proven",
          "inbound_observation_proven",
          "reconnect_proven",
          "restart_proven",
          "wrong_id_rejected",
          "revoked_binding_rejected",
          "stale_attempt_rejected",
          "text_private_by_default",
          "no_acceptance_authority",
          "gateway_restart_proven",
          "cancellation_stop_proven",
          "station_binding",
          "executed_hooks"
        ],
        "properties": {
          "name": {
            "enum": [
              "hermes",
              "openclaw"
            ]
          },
          "runtime_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "build_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "plugin_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hook_registration_proven": {
            "const": true
          },
          "context_delivery_proven": {
            "const": true
          },
          "inbound_observation_proven": {
            "const": true
          },
          "reconnect_proven": {
            "const": true
          },
          "restart_proven": {
            "const": true
          },
          "wrong_id_rejected": {
            "const": true
          },
          "revoked_binding_rejected": {
            "const": true
          },
          "stale_attempt_rejected": {
            "const": true
          },
          "text_private_by_default": {
            "const": true
          },
          "no_acceptance_authority": {
            "const": true
          },
          "gateway_restart_proven": {
            "type": "boolean"
          },
          "cancellation_stop_proven": {
            "type": "boolean"
          },
          "station_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_id",
              "task_id",
              "attempt",
              "spec_hash"
            ],
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "spec_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "executed_hooks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hook",
                "evidence_file"
              ],
              "properties": {
                "hook": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "evidence_file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "two_conversation_demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_station_task",
        "both_conversations_received_current_context",
        "bidirectional_observation_proven",
        "false_completion_did_not_accept",
        "station_verifier_completed_transition"
      ],
      "properties": {
        "same_station_task": {
          "const": true
        },
        "both_conversations_received_current_context": {
          "const": true
        },
        "bidirectional_observation_proven": {
          "const": true
        },
        "false_completion_did_not_accept": {
          "const": true
        },
        "station_verifier_completed_transition": {
          "const": true
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "verdict",
        "reviewer_not_executor"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "const": "PASS"
        },
        "reviewer_not_executor": {
          "const": true
        }
      }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
