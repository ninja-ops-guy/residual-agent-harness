{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residual.invalid/schemas/r4.1-promotion-decision-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "disposition", "run_id", "candidate_head", "candidate_tree", "evaluated_evidence_sha256", "authorization_receipt_sha256", "checks", "reasons", "promotion_performed", "human_promotion_required"],
  "properties": {
    "schema": {"const": "residual.r4.1.promotion-decision/v1"},
    "disposition": {"enum": ["PROMOTION_ELIGIBLE", "CANARY_FAILED", "EVIDENCE_INCOMPLETE", "ROLLBACK_REQUIRED"]},
    "run_id": {"type": ["string", "null"]}, "candidate_head": {"type": ["string", "null"]}, "candidate_tree": {"type": ["string", "null"]},
    "evaluated_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorization_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "INCOMPLETE", "ROLLBACK"]}},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "promotion_performed": {"const": false}, "human_promotion_required": {"const": true}
  }
}
